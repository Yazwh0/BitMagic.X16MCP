<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Shared.VSCodeDebugProtocol" Version="17.2.60629.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <!--
    X16D isn't bundled by this project's build - locally it's pointed to via config
    (the X16D_PATH env var, or the "x16d" command line option; see Properties/launchSettings.json)
    so it can still be stepped into from Visual Studio without a copy step getting in the way.
    CI is responsible for producing a bundled artifact (see Program.cs's "x16d/X16D.exe next
    to us" fallback).
  -->

  <!--
    Published as a .NET tool with a bundled X16D per RID (see "RuntimeIdentifierPackages" in the
    resulting nuspec): `dotnet tool install` auto-selects BitMagic.X16M.win-x64 or .linux-x64,
    each carrying only its own platform's x16d/ payload, so AppContext.BaseDirectory\x16d
    resolves the same way it does for the zipped release build - no code changes needed here.
    CI stages the already-built per-OS debugger output into ../x16d-win-x64/ and
    ../x16d-linux-x64/ (see build-test.yml's "nuget-publish" job) before running `dotnet pack`.
    These live one level *above* this project directory, not inside it - the SDK's implicit
    globs (Compile/Content/etc.) scan the whole project directory tree, and X16D's bundle
    includes loose .cs library sources that would otherwise get swept up and compiled into X16M.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>x16m</ToolCommandName>
    <PackageId>BitMagic.X16M</PackageId>
    <Title>X16M</Title>
    <Description>Lets an AI agent debug BitMagic X16 programs: set breakpoints, step through code, and inspect the stack and memory.</Description>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>butterfly.jpg</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="icon/butterfly.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="../x16d-win-x64/**" Pack="true" PackagePath="tools/$(TargetFramework)/win-x64/x16d/" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Content Include="../x16d-linux-x64/**" Pack="true" PackagePath="tools/$(TargetFramework)/linux-x64/x16d/" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
